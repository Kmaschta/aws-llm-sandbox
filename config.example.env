# llm-sandbox configuration - copy to config.env and edit. config.env is gitignored.
# shellcheck shell=bash

# ---------------------------------------------------------------- AWS
AWS_REGION=""                      # empty = the aws cli's default region; or e.g. "eu-central-1"
TAG_NAME="llm-sandbox"             # Name tag on every resource the scripts create; they never touch anything else.
                                   # Also the security group name and the "Host" alias written to ~/.ssh/config.

# SSH key pair. On the first ./up.sh, if KEY_NAME does not exist in EC2 the script offers to create it
# (private key saved to SSH_KEY) or, if SSH_KEY already exists locally, to import its public key.
KEY_NAME="llm-sandbox"
SSH_KEY="$HOME/.ssh/llm-sandbox.pem"
SSH_HOST_ALIAS="$TAG_NAME"         # `ssh llm-sandbox` works after up.sh (HostName is rewritten on every start)
SSH_USER="ec2-user"                # login user of the AMI below

# Elastic IP: keeps the same public IP across stop/start (~$3.6/month, billed even while stopped).
#   auto          reuse the EIP tagged Name=TAG_NAME; on the first launch, ask whether to allocate one
#   none          never use one; the public IP changes on every start (the scripts update ~/.ssh/config)
#   eipalloc-...  use this existing allocation
ELASTIC_IP="auto"

# ---------------------------------------------------------------- instance
ROOT_GB=200                        # root disk; ~18 GB per 30B-class model, ~10 GB for the OS
ROOT_DEVICE="/dev/xvda"            # root device name of the AMI
# Latest AWS "Deep Learning Base OSS Nvidia Driver GPU AMI (Amazon Linux 2023)": NVIDIA driver preinstalled
# and matched to the kernel. Resolved through SSM at launch, so it is always current.
AMI_SSM_PARAMETER="/aws/service/deeplearning/ami/x86_64/base-oss-nvidia-driver-gpu-amazon-linux-2023/latest/ami-id"
# Families whose single-GPU sizes are proposed in the menu. This is every x86 family with a one-NVIDIA-GPU
# size as of 2026; families not offered in AWS_REGION are simply absent from the menu, so the list works in
# any region. Left out on purpose: g5g (arm64, needs the arm64 AMI), g6f/gr6f (fractional GPU slices),
# p4/p5e/p6 (8-GPU sizes only). Remove families here to shorten the menu.
INSTANCE_FAMILIES="g4dn g5 g6 gr6 g6e g7 g7e p5"
PRICE_HEADROOM="0.20"              # spot max price = the price you approve * (1 + headroom)

# One line per GPU model, shown in the GPU menu. Variable suffix = GPU name as reported by AWS.
GPU_NOTES_T4="2018 gen (g4dn). Cheapest; fits <=14B models at q4. Too small for 30B."
GPU_NOTES_A10G="2021 gen (g5). Same 24 GB tier as L4, ~same speed for Ollama; a second pool when g6 has no capacity."
GPU_NOTES_L4="2023 gen (g6, gr6 = same GPU with 2x system RAM). 24 GB: one 30B model at q4 (~18 GB) + KV cache; only one big model resident at a time."
GPU_NOTES_RTX_PRO_4500="2025 gen (g7, Blackwell). 32 GB, ~L4 price: a 30B model at q4 with a large context, or 32B dense at q4."
GPU_NOTES_L40S="2023 gen (g6e). 48 GB, ~2-3x L4 throughput: two 30B models resident, or 70B at q4, or 30B with a huge context."
GPU_NOTES_H100="2022 gen (p5.4xlarge). 80 GB HBM3, fastest memory here: 70B at q8 or 120B-class MoE at q4. Spot needs the P quota (L-7212CCBC), on-demand the P on-demand quota; few regions have it."
GPU_NOTES_RTX_PRO_Server_6000="2025 gen (g7e, Blackwell). 96 GB, often priced like the L40S: 70B at q8, 120B-class MoE at q4, or several 30B models resident."

# ---------------------------------------------------------------- ollama
# Models pulled at first boot (space-separated, names from https://ollama.com/library). Ollama loads
# them on demand and swaps them in VRAM; the FIRST one is loaded at the end of up.sh.
# On a running instance use ./models.sh (sync / pull / rm); editing this only affects the next fresh launch.
MODELS="qwen3-coder:30b"
OLLAMA_PORT=11434
# Environment of the ollama systemd service (written to /etc/systemd/system/ollama.service.d/override.conf).
# OLLAMA_CONTEXT_LENGTH is the starting point: loading a model fits it to the GPU and rewrites it on the box.
OLLAMA_ENV=(
  "OLLAMA_HOST=0.0.0.0:11434"
  "OLLAMA_CONTEXT_LENGTH=32768"
  "OLLAMA_NUM_PARALLEL=1"
  "OLLAMA_FLASH_ATTENTION=1"
  "OLLAMA_KV_CACHE_TYPE=q8_0"
  "OLLAMA_KEEP_ALIVE=30m"
)
